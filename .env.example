# O site estático NÃO precisa de nenhuma chave. Estas variáveis só servem ao pipeline Python
# ou a um futuro backend. Nunca coloque credenciais em variáveis VITE_*: elas vão para o navegador.

# NASA Earthdata Login (baixar os HDF5 NISAR GCOV completos): https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# NASA FIRMS (focos de calor direto da NASA): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Meteomatics (oferta do hackathon). Usar apenas em servidor ou no pipeline.
METEOMATICS_USER=
METEOMATICS_PASSWORD=
